  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        },
        "$description": "Hover and focus feedback."
      },
      "normal": {
        "$value": {
          "value": 200,
          "unit": "ms"
        },
        "$description": "State changes such as toggles."
      },
      "zoom": {
        "$value": {
          "value": 380,
          "unit": "ms"
        },
        "$description": "Zooming a text box into and out of the reader."
      },
      "zoom-out": {
        "$value": {
          "value": 320,
          "unit": "ms"
        },
        "$description": "Zooming a text box back out of the reader: a little quicker than zooming in."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1],
        "$description": "Default easing for UI transitions."
      },
      "zoom-out": {
        "$value": [0.45, 0, 0.55, 1],
        "$description": "Symmetric ease in and out, so a shrink back reads as one move (the decelerating standard curve leaves a long slow tail that looks like a second shrink)."
      }
    }
  },
