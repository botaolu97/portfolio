  "color": {
    "$description": "Semantic colors. Each has a light value and a dark mode value.",
    "$type": "color",
    "canvas": {
      "$value": "{palette.neutral.50}",
      "$description": "Page and canvas background.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.neutral.950}"
        }
      }
    },
    "canvas-dot": {
      "$value": "{palette.neutral.300}",
      "$description": "Dot grid on the canvas.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.neutral.700}"
        }
      }
    },
    "surface": {
      "$value": "{palette.white}",
      "$description": "Cards, panels, inputs on the canvas.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.neutral.850}"
        }
      }
    },
    "surface-muted": {
      "$value": "{palette.neutral.100}",
      "$description": "Hover fills, title bars, placeholders.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.neutral.800}"
        }
      }
    },
    "border": {
      "$value": "{palette.neutral.200}",
      "$description": "Default 1px borders and dividers.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.neutral.750}"
        }
      }
    },
    "text": {
      "$value": "{palette.neutral.900}",
      "$description": "Primary text.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.neutral.150}"
        }
      }
    },
    "text-muted": {
      "$value": "{palette.neutral.500}",
      "$description": "Secondary text, labels, hints.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.neutral.400}"
        }
      }
    },
    "text-on-accent": {
      "$value": "{palette.white}",
      "$description": "Text on accent or danger fills."
    },
    "accent": {
      "$value": "{palette.blue.500}",
      "$description": "Primary actions, selection, focus.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.blue.300}"
        }
      }
    },
    "accent-soft": {
      "$value": "{palette.blue.100}",
      "$description": "Tinted backgrounds behind accent content.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.blue.900}"
        }
      }
    },
    "danger": {
      "$value": "{palette.red.500}",
      "$description": "Destructive actions and errors.",
      "$extensions": {
        "app.mubu.modes": {
          "dark": "{palette.red.400}"
        }
      }
    },
    "note": {
      "$description": "Sticky note fills. Notes stay light in dark mode, like paper.",
      "yellow": {
        "$value": "{palette.note.yellow}",
        "$description": "Default note color."
      },
      "pink": {
        "$value": "{palette.note.pink}"
      },
      "green": {
        "$value": "{palette.note.green}"
      },
      "blue": {
        "$value": "{palette.note.blue}"
      },
      "purple": {
        "$value": "{palette.note.purple}"
      }
    }
