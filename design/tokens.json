    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1,
        "$description": "Single-line controls."
      },
      "snug": {
        "$value": 1.4,
        "$description": "Hints and short paragraphs."
      },
      "normal": {
        "$value": 1.5,
        "$description": "Body text."
      }
    }
  },
