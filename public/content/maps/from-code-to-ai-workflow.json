        "y": -240
      },
      "data": {
        "html": "<h1>Design Challenges</h1><p></p><p>Fundamentally, there're three:</p><p></p><ul><li><p>Mapping out the user workflow behind the technical languages</p></li><li><p>Bringing the team to a shared understanding</p></li><li><p>Designing for amateur and advanced user at the same time</p></li></ul><p></p>",
        "size": "xl"
      },
      "width": 600,
