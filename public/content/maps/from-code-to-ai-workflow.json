    {
      "id": "e0c7d3b1",
      "type": "text",
      "position": {
        "x": -720,
        "y": 888
      },
      "data": {
        "html": "<h1>User Pain Points</h1><p></p><p>Previously, users rely on fragmented technical documentation to identify the right model, then learn and write MATLAB code to configure and run it. Much of their time is spent debugging, while comparing results requires manually generating plots with limited interactivity.</p><p></p>",
        "size": "sm"
      },
      "width": 272,
      "height": 264
    },
