{
  "name": "mubu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "tokens": "node scripts/tokens.ts",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens -- --check",
    "delete-canvas": "node scripts/delete-canvas.ts",
    "start": "npm run build && (npm run preview & npm run dev)"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/handjet": "^5.3.1",
    "@fontsource/fasthand": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
